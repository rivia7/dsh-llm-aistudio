{
  "name": "dsh-llm-aistudio",
  "version": "0.1.0",
  "description": "DeepSeek Harness model provider for Google AI Studio (Gemini API): direct REST streaming with your own API key, no pi-ai and no @google/genai.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "gemini",
    "aistudio",
    "llm-provider"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "link-dev": "sh scripts/link-dev-deps.sh",
    "test": "node --test \"tests/*.test.mjs\"",
    "smoke": "node scripts/live-smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
